{
  "name": "agi-prime",
  "version": "1.1.0",
  "description": "AGI PRIME — The Ultimate AI Consciousness Platform",
  "author": "Aaron Grace",
  "homepage": "https://github.com/aarongrace978/agi",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "start:daemon": "electron . --daemon",
    "dist": "vite build && electron-builder --publish never",
    "dist:win": "vite build && electron-builder --win --x64 --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --x64 --publish never",
    "dist:steamdeck": "vite build && electron-builder --linux AppImage --x64 --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check-all": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "memory:compact:vectors": "node scripts/compact-vectors.js",
    "memory:compact:exports": "node scripts/compact-memory-exports.js",
    "memory:compact:exports:dry": "node scripts/compact-memory-exports.js --dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.0.3",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.1"
  }
}
